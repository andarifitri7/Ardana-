# ==========================================
# TATADANA FINTECH SAAS CONFIGURATION
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_BASE_URL=https://tatadana.id

# Telegram Bot
# Token diperoleh dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=7812345678:AAF-ExampleTataDanaBotTokenABCxyz123

# AI Multi-Provider Credentials
# Dikelola via Admin Dashboard (disimpan terenkripsi) atau .env default
GEMINI_API_KEY=AIzaSyExampleGeminiApiKeyTataDana
OPENAI_API_KEY=sk-proj-exampleOpenAiKeyTataDana
DEEPSEEK_API_KEY=sk-exampleDeepSeekApiKeyTataDana

# Supabase Postgres & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exampleAnonKey
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exampleServiceRoleKey
SUPABASE_STORAGE_BUCKET=tatadana-reports

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-ExampleTataDanaKey
MIDTRANS_CLIENT_KEY=SB-Mid-client-ExampleTataDanaKey
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-ExampleTataDanaKey
MIDTRANS_IS_PRODUCTION=false

# Email Service (Native SMTP Client & Resend REST Fallback for Real OTP Delivery)
# Supports port 465 (SSL/TLS direct) & port 587 (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ardana.fintech@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_FROM="Ardana FinTech <no-reply@ardana.id>"
RESEND_API_KEY=re_example_api_key_here

# Superadmin & Application Settings
SUPERADMIN_EMAIL=andariftri7@gmail.com
ADMIN_PASSWORD=AdminArdana2026!
